# Секреты и локальная настройка — шаблон .env.example коммитится, сам .env нет
.env
.env.local

# Внутренние рабочие документы — не для публичного репозитория
/PLAN.md
/CLAUDE.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Кеш приложения: индекс, метаданные, миниатюры, прокси (см. README «Где что хранится»).
# В норме лежит внутри корня медиатеки (MEDIA_ROOTS), а не в репозитории; секция на случай,
# если DATA_DIR указывает сюда, — в кеше миниатюры и пути реальной медиатеки пользователя.
/data/

# Claude Code — локальные настройки сессии, не часть проекта
.claude/

# ОС
.DS_Store
Thumbs.db

# Логи
*.log
