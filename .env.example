# ---- Агент (LLM) ----
# Провайдер: openai | custom
AGENT_PROVIDER=openai

# --- Провайдер openai: официальный API OpenAI ---
# Пример: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
# Модель с поддержкой function calling. Пример: gpt-4.1-mini
OPENAI_CHAT_MODEL=
# У части моделей с рассуждениями (o-серия, GPT-5 и т. п.) function tools в
# /v1/chat/completions не работают без reasoning_effort="none" — если модель вернёт
# 400 "Function tools with reasoning_effort are not supported...", впишите none.
# Пусто — параметр не отправляется (старые модели не знают его и тоже вернут 400).
OPENAI_REASONING_EFFORT=
# Модель эмбеддингов для семантического поиска (search_media). Используется независимо
# от AGENT_PROVIDER — нужны OPENAI_API_KEY и эта модель, даже если чат идёт через custom.
# Пример: text-embedding-3-small
OPENAI_EMBED_MODEL=

# --- Провайдер custom: любой OpenAI-совместимый эндпоинт (z.ai и т. п.) ---
# Пример: https://api.z.ai/api/paas/v4
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Имя модели, как его знает эндпоинт. Пример: glm-4.6
CUSTOM_CHAT_MODEL=

# Предел шагов агента за один запрос. Шаг — это один ответ модели, а вызовов
# инструментов в нём может быть несколько, так что ролику на 20–25 клипов хватает
# и полусотни шагов; занижать не стоит — на исчерпании бюджета монтаж останется
# собранным частично.
MAX_STEPS_AGENT=100
# Бюджет токенов на один ответ модели. У моделей с рассуждениями скрытые токены
# рассуждений тоже считаются из этого бюджета — если агент отвечает пустыми
# сообщениями без вызовов инструментов, увеличьте.
MAX_TOKENS_AGENT=4000
# Столько шагов подряд без изменений в таймлайне — и агенту шлют подсказку начать
# добавлять клипы, а не продолжать искать материал.
STALL_NUDGE_THRESHOLD=15

# ---- Анализ (VL, локально через Ollama) ----
# Адрес локального сервера Ollama.
OLLAMA_BASE_URL=http://localhost:11434
# Основная модель анализа медиа.
VL_MODEL=qwen2.5vl:7b
# Быстрая модель для режима «быстрая модель» в интерфейсе — менее точная, но быстрее.
VL_MODEL_FAST=qwen2.5vl:3b

# ---- Хранилище медиа ----
# Корневые папки хранилища по умолчанию; несколько — через запятую, ~ разворачивается.
# Приоритет: папки, добавленные в UI (таблица settings) > MEDIA_ROOTS > пусто.
# Пусто — хранилище выбирается прямо в интерфейсе.
# Пример: MEDIA_ROOTS=~/Movies/Footage,/Volumes/Archive/Video
MEDIA_ROOTS=

# Папка кеша: метаданные, миниатюры, прокси и база индекса.
# Пусто — кеш создаётся как `data` внутри первого корня хранилища (или рядом с
# приложением, пока хранилище не выбрано).
# Пример: DATA_DIR=~/Library/Application Support/IntelligentVideoEditor
DATA_DIR=

# ---- Прочее ----
# Пути к бинарникам, если их нет в PATH.
# Пример: FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFMPEG_PATH=
# Пример: FFPROBE_PATH=/opt/homebrew/bin/ffprobe
FFPROBE_PATH=
# Пример: FFPLAY_PATH=/opt/homebrew/bin/ffplay
FFPLAY_PATH=

# Предел кадров на одно видео при анализе: фактический шаг выборки растягивается,
# если кадров по FRAME_SAMPLE_SECONDS получается больше этого предела.
MAX_FRAMES=5
# Желаемый шаг выборки кадров видео для анализа, в секундах.
FRAME_SAMPLE_SECONDS=2
# Кадры и фото сжимаются до этой стороны (px) перед отправкой в модель.
MODEL_IMAGE_MAX_SIDE=640
